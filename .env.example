# Alibaba Cloud Bailian Rich Code Application — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Required at app runtime: Bailian/DashScope API Key, used by AgentScope's
# DashScopeChatModel for LLM generation (RuntimeAgent).
DASHSCOPE_API_KEY=

# Required at app runtime (stage 1.2+): Alibaba Cloud AccessKey pair, used by
# BaiLianKB to call the Bailian knowledge base `Retrieve` OpenAPI directly
# (via alibabacloud_bailian20231229). Also used by `runtime-fc-deploy` for
# upload auth. Prefer a RAM sub-user AccessKey with least-privilege access
# over the primary account's AccessKey.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Required at app runtime: the workspace and knowledge base index that
# BaiLianKB retrieves from. Get these via:
#   aliyun bailian ListIndices --WorkspaceId <ws-id>
# (see https://help.aliyun.com/zh/model-studio/obtain-the-app-id-and-workspace-id
# for how to find your Workspace ID in the console).
BAILIAN_WORKSPACE_ID=
BAILIAN_INDEX_ID=

# Optional: region for the Bailian OpenAPI endpoint (bailian.<region>.aliyuncs.com).
# Must match the region your AccessKey/workspace/index were created in.
BAILIAN_REGION_ID=cn-beijing

# Deprecated (kept only for backward compatibility): no longer used for RAG.
# Retrieval now goes directly against BAILIAN_INDEX_ID above, bypassing the
# Bailian "application" concept entirely.
BAILIAN_APP_ID=

# Optional tuning
BAILIAN_RAG_TOP_K=5
RAG_TIMEOUT_SEC=10.0
LOG_LEVEL=INFO
